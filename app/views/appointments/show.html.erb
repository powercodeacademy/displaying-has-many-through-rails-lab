<h1>Appointment </h1>
<p>Appointments:<%= link_to @appointment.doctor.name, doctor_path(@appointment.doctor) %></p>
<p>Patients:<%= link_to @appointment.patient.name, patient_path(@appointment.patient) %></p>
<p>Date: <%= @appointment.appointment_datetime.strftime("%B %d, %Y") %></p>
<p>Time: <%= @appointment.appointment_datetime.strftime("%H:%M") %></p>
