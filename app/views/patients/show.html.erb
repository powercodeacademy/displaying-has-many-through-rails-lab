<h3>Patient's Information</h3>

  <div>
    <p>Name: <%= @patient.name %></p>
    <p>Age: <%= @patient.age %></p>

    <h4>Patient's Appointments:</h4>
    <ul>
      <% @patient.appointments.each do |appointment| %>
        <li><%= appointment.appointment_datetime.strftime("%B %d, %Y at %H:%M")%></li>
      <% end %>
    </ul>

    <h4>Doctors:</h4>
    <ul>
      <% @patient.doctors.distinct.each do |doctor| %>
        <li><%= link_to doctor.name, doctor %></li>
      <% end %>
    </ul>
  </div>

  <hr>